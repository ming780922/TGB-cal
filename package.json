{
  "name": "tgb-calendar",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently --names 'worker,web' --kill-others \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:worker": "pnpm --filter @tgb-calendar/worker dev --persist-to ../web/.wrangler/state",
    "dev:web": "pnpm --filter @tgb-calendar/web dev",
    "build:web": "pnpm --filter @tgb-calendar/web pages:build",
    "db:migrate": "npx wrangler d1 migrations apply tgb-cal --local --persist-to apps/web/.wrangler/state --config apps/web/wrangler.toml",
    "db:reset": "rm -rf .wrangler apps/web/.wrangler && pnpm db:migrate",
    "scrape": "node packages/scraper/index.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
